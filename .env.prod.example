APP_NAME="Api Temperinho"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.temperinho.pepefcardoso.dev
APP_FRONTEND_URL=https://temperinho.pepefcardoso.dev
APP_TIMEZONE=UTC
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_SENTRY_DSN=

FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
CACHE_STORE=redis
SCOUT_DRIVER=meilisearch
BROADCAST_CONNECTION=log
APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=temperinho
DB_USERNAME=temperinho
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.pepefcardoso.dev

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

MAIL_MAILER=ses
MAIL_FROM_ADDRESS="contato@temperinho.com.br"
MAIL_FROM_NAME="${APP_NAME}"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

BCRYPT_ROUNDS=12
CORS_ALLOWED_ORIGINS=https://temperinho.pepefcardoso.dev,https://admin.temperinho.pepefcardoso.dev
SANCTUM_STATEFUL_DOMAINS=temperinho.pepefcardoso.dev,admin.temperinho.pepefcardoso.dev

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_BIRTHDAY=1990-01-01
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_ROLE=admin

# build args (front)
NEXT_PUBLIC_API_URL=https://api.temperinho.pepefcardoso.dev/api
NEXT_PUBLIC_SITE_URL=https://temperinho.pepefcardoso.dev
NEXT_PUBLIC_URL=https://temperinho.pepefcardoso.dev
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
NEXT_PUBLIC_GOOGLE_AD_CLIENT=
NEXT_PUBLIC_GOOGLE_AD_SLOT_ABOUT_US=
NEXT_PUBLIC_GOOGLE_AD_SLOT_BLOG_DETAILS=
NEXT_PUBLIC_GOOGLE_AD_SLOT_BLOG_LEADERBOARD=
NEXT_PUBLIC_GOOGLE_AD_SLOT_CONTACT_US=
NEXT_PUBLIC_GOOGLE_AD_SLOT_HOMEPAGE_BANNER=
NEXT_PUBLIC_GOOGLE_AD_SLOT_RECIPES_LEADERBOARD=
NEXT_PUBLIC_GOOGLE_AD_SLOT_RECIPE_DETAIL=
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
FRONT_SENTRY_PROJECT=
FRONT_SENTRY_DSN=
ADMIN_SENTRY_DSN=
